      "type": "streamable-http",
      "url": "https://ibmec-conecta-calendario.onrender.com/conta/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["ibmec.demo"],
            "defaultScopes": ["ibmec.demo"]
          }
        }
      }
    }
  }
}
